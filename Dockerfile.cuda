# syntax=docker/dockerfile:1.7
#
# CUDA image — NVIDIA CUDA 12.6 base + PyTorch CUDA + nemo_toolkit[asr] +
# faster-whisper + kokoro (TTS). Serves whisper variants, parakeet-tdt, all
# three canary models (180m-flash, 1b-flash, canary-qwen-2.5b) for ASR, plus
# kokoro-82m TTS via /v1/audio/speech.
#
# We use the CUDA runtime base (not cudnn-devel) and let pytorch's bundled
# CUDA libs handle the rest. nemo_toolkit[asr] pulls flash-attn etc. on
# install — keep build-essential in the builder stage.
#
# Supply chain:
#   Lightweight runtime deps: uv sync --frozen from uv.lock (hash-verified).
#   Heavy ML stack: uv pip install --require-hashes from requirements-heavy-cuda.txt
#   (generated by scripts/compile-heavy-deps.sh — run `make compile-heavy` to refresh).
#
# Version rationale + open-CVE threat model in scripts/heavy-deps-cuda.in.
# Known open CVEs (threat-modelled; not exploitable in this app):
#   PYSEC-2026-139 (torch pt2 load): we don't torch.load() untrusted files.
#   GHSA-75m9-98v2-hjpm (PL load_from_checkpoint): we don't call it.
#   GHSA-69w3-r845-3855 / PYSEC-2025-217 (transformers Trainer): we don't train.

FROM python:3.12-slim-bookworm@sha256:d193c6f51a7dbd10395d6328de3a7edb0516fb0608ca138036576f574c3e07d2 AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        curl \
        cmake \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.15@sha256:e590846f4776907b254ac0f44b5b380347af5d90d668138ca7938d1b0c2f98d3 /uv /usr/local/bin/uv

WORKDIR /app

# 1) Lightweight runtime deps — frozen install from uv.lock, hash-verified.
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv /opt/venv && \
    uv sync --frozen --no-dev

# The PyPI Sherpa wheel is CPU-only. Replace it in the CUDA variant with the
# upstream CUDA 12 / cuDNN 9 wheel, pinned by its content hash. This wheel
# contains Sherpa's native CUDA execution provider; onnxruntime-gpu alone
# cannot add that provider to a CPU-built Sherpa library.
ARG SHERPA_ONNX_CUDA_WHEEL_URL="https://huggingface.co/csukuangfj2/sherpa-onnx-wheels/resolve/main/cuda/1.13.4/sherpa_onnx-1.13.4+cuda12.cudnn9-cp312-cp312-linux_x86_64.whl"
ARG SHERPA_ONNX_CUDA_WHEEL_FILE="sherpa_onnx-1.13.4+cuda12.cudnn9-cp312-cp312-linux_x86_64.whl"
ARG SHERPA_ONNX_CUDA_WHEEL_SHA256="76ffc8a204a00df51d2d8e87f38c204640370b45c24c33f0e1b87d846aeb6c52"
RUN --mount=type=cache,target=/root/.cache/uv \
    curl --fail --location --retry 3 --retry-delay 2 \
        "$SHERPA_ONNX_CUDA_WHEEL_URL" \
        --output "/tmp/$SHERPA_ONNX_CUDA_WHEEL_FILE" \
    && echo "$SHERPA_ONNX_CUDA_WHEEL_SHA256  /tmp/$SHERPA_ONNX_CUDA_WHEEL_FILE" \
        | sha256sum --check \
    && uv pip install --python /opt/venv/bin/python --no-deps \
        "/tmp/$SHERPA_ONNX_CUDA_WHEEL_FILE" \
    && rm "/tmp/$SHERPA_ONNX_CUDA_WHEEL_FILE"

# 2) Heavy ML deps — CUDA torch + nemo_toolkit[asr] + qwen3-tts. Hash-locked.
COPY requirements-heavy-cuda.txt ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /opt/venv/bin/python \
        --no-config \
        --require-hashes \
        --no-deps \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
        --index-strategy unsafe-best-match \
        -r requirements-heavy-cuda.txt

# -----------------------------------------------------------------------------
# Precompiled parakeet.cpp shared C API used by the parakeet_cpp backend
# (NVIDIA Parakeet TDT/CTC/RNNT + Nemotron-3.5-ASR via ggml/C++). The upstream
# CUDA 12 bundle was built with CUDA 12.9 and includes its matching cudart and
# cuBLAS libraries beside libparakeet.so. The published digest pins its bytes.
ARG PARAKEET_CPP_BUNDLE_URL="https://github.com/mudler/parakeet.cpp/releases/download/v0.5.0/parakeet-v0.5.0-lib-linux-cuda12-x64.tar.gz"
ARG PARAKEET_CPP_BUNDLE_FILE="parakeet-v0.5.0-lib-linux-cuda12-x64.tar.gz"
ARG PARAKEET_CPP_BUNDLE_SHA256="7c3a151793050436386b2699ad025ae96713f34e8a070a9f2029c39d57162ec1"
RUN mkdir -p /opt/parakeet \
    && curl --fail --location --retry 3 --retry-delay 2 \
        "${PARAKEET_CPP_BUNDLE_URL}" \
        --output "/tmp/${PARAKEET_CPP_BUNDLE_FILE}" \
    && echo "${PARAKEET_CPP_BUNDLE_SHA256}  /tmp/${PARAKEET_CPP_BUNDLE_FILE}" \
        | sha256sum --check \
    && tar --extract --gzip \
        --file "/tmp/${PARAKEET_CPP_BUNDLE_FILE}" \
        --directory /opt/parakeet \
        --strip-components=1 \
        --no-same-owner \
        --no-same-permissions \
    && test -f /opt/parakeet/libparakeet.so \
    && test -f /opt/parakeet/parakeet_capi.h \
    && test -f /opt/parakeet/LICENSE \
    && rm "/tmp/${PARAKEET_CPP_BUNDLE_FILE}"

# -----------------------------------------------------------------------------
# Runtime — uses CUDA 12.6 runtime on ubuntu24.04 (python3.12 in base repos).
FROM nvidia/cuda:12.6.3-runtime-ubuntu24.04@sha256:92906d87596d638d35015c6353053121bd299d25943b875763321653884ba924 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    TZ=UTC \
    TALKIES_DEVICE=cuda \
    TALKIES_MODELS_FILE=/app/models.json \
    TALKIES_DATA_DIR=/data \
    HF_HOME=/data/hf \
    HF_HUB_OFFLINE=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    TORCHINDUCTOR_CACHE_DIR=/tmp/torch_inductor \
    LD_LIBRARY_PATH=/opt/venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/opt/venv/lib/python3.12/site-packages/nvidia/cublas/lib \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3-pip \
        ffmpeg \
        libsndfile1 \
        libgomp1 \
        ca-certificates \
        espeak-ng \
    && rm -rf /var/lib/apt/lists/* \
    && (userdel -r ubuntu 2>/dev/null || true) \
    && useradd -u 1000 --create-home --shell /bin/bash talkies \
    && mkdir -p /data \
    && chown talkies:talkies /data \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python3 \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv

# The precompiled shared library folds ggml into libparakeet.so and carries
# matching CUDA runtime libraries beside it. Keep the bundle isolated so its
# CUDA libraries do not replace the Python ML stack's globally.
COPY --from=builder /opt/parakeet/ /opt/parakeet/
ENV TALKIES_PARAKEET_CPP_LIB=/opt/parakeet/libparakeet.so

COPY --chown=talkies:talkies src ./src
COPY --chown=talkies:talkies pyproject.toml ./
COPY --chown=talkies:talkies models.json /app/models.json
COPY --chown=talkies:talkies voices/qwen3/ /opt/talkies/qwen3-voices/
COPY --chown=talkies:talkies entrypoint.sh /usr/local/bin/talkies-entrypoint
RUN sed -i 's/\r$//' /usr/local/bin/talkies-entrypoint \
    && chmod +x /usr/local/bin/talkies-entrypoint

USER talkies

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/healthz').status==200 else 1)" || exit 1

ENTRYPOINT ["/usr/local/bin/talkies-entrypoint"]
